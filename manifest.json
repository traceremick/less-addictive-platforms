{
  "manifest_version": 3,
  "name": "Less Addictive Platforms",
  "version": "1.0",
  "description": "Strips engagement and dopamine traps from sites to make them less addictive and more productive.",
  "permissions": ["activeTab", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["*://*.duckduckgo.com/*"],
      "js": ["duckduckgo-content.js"]
    },
    {
      "matches": ["*://*.google.com/*"],
      "js": ["google-content.js"]
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["twitchtv-content.js"]
    },
    {
      "matches": ["*://*.nytimes.com/*"],
      "js": ["nyt-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["timeout-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["level-line-content.js"],
      "all_frames": true
    }
  ]
}
